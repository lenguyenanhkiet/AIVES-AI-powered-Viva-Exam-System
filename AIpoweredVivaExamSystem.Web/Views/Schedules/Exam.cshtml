@model AIpoweredVivaExamSystem.Web.ViewModels.Schedules.ExamScheduleViewModel
@{
    var exam = Model.Exam;
    ViewData["Title"] = "Lịch thi · " + exam.Name;
}

<div class="container stack">
    <div>
        <nav class="breadcrumb">
            <a asp-action="Index">Lịch thi</a> @Icons.Get("chevron-right", 14) <span>@exam.Name</span>
        </nav>
        <div class="page-head">
            <div>
                <div class="head-tags"><partial name="_ExamStatus" model="exam.Status" /></div>
                <h1 class="page-title">@exam.Name</h1>
                <p class="page-sub">
                    @exam.StartAt.ToLocalText() – @exam.EndAt.ToLocalText() · mỗi ca @Model.DurationMinutes phút · Giờ Việt Nam (UTC+7)
                </p>
            </div>
        </div>
    </div>

    @if (!Model.CanEdit)
    {
        <div class="alert alert-info">@Icons.Get("alert") Chỉ có thể xếp lịch khi kỳ thi ở trạng thái Nháp. Lịch dưới đây chỉ để xem.</div>
    }
    else
    {
        <div class="card">
            <div class="card-head">
                <div>
                    <div class="card-title">Xếp lịch tự động</div>
                    <span class="muted">Chia sinh viên trong danh sách thi thành các ca liên tiếp @Model.DurationMinutes phút, bắt đầu từ giờ mở kỳ thi.</span>
                </div>
                <form method="post" asp-action="Preview" asp-route-id="@exam.Id">
                    <button class="btn btn-primary" type="submit">@Icons.Get("calendar") Xem trước lịch</button>
                </form>
            </div>
        </div>
    }

    @if (Model.Preview is not null)
    {
        <div class="card">
            <div class="card-head">
                <div>
                    <div class="card-title">Bản xem trước</div>
                    <span class="muted">Chưa lưu · Giờ Việt Nam (UTC+7). Áp dụng sẽ thay thế lịch hiện tại.</span>
                </div>
                @if (Model.CanEdit && Model.Preview.Count > 0)
                {
                    <form method="post" asp-action="Apply" asp-route-id="@exam.Id">
                        <input type="hidden" name="previewToken" value="@Model.PreviewToken" />
                        <button class="btn btn-success" type="submit">@Icons.Get("check") Áp dụng lịch</button>
                    </form>
                }
            </div>
            @if (Model.Preview.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon">@Icons.Get("inbox", 20)</div>
                    <div class="empty-title">Không có sinh viên để xếp lịch</div>
                </div>
            }
            else
            {
                <partial name="_ScheduleTable" model="Model.Preview" />
            }
        </div>
    }

    <div class="card">
        <div class="card-head">
            <div>
                <div class="card-title">Lịch hiện tại</div>
                <span class="muted">Giờ Việt Nam (UTC+7)</span>
            </div>
        </div>
        @if (Model.Current.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon">@Icons.Get("calendar", 20)</div>
                <div class="empty-title">Chưa có sinh viên trong danh sách thi</div>
            </div>
        }
        else
        {
            <partial name="_ScheduleTable" model="Model.Current" />
        }
    </div>
</div>
