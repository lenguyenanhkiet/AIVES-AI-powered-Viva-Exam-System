@model AIpoweredVivaExamSystem.Web.ViewModels.Schedules.MyScheduleViewModel
@{ ViewData["Title"] = "Lịch thi của tôi"; }

<div class="container">
    <div class="page-head">
        <div>
            <h1 class="page-title">Lịch thi của tôi</h1>
            <p class="page-sub">Các ca thi vấn đáp đã được xếp cho bạn. Giờ Việt Nam (UTC+7).</p>
        </div>
    </div>

    <div class="card">
        @if (Model.Items.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon">@Icons.Get("calendar", 20)</div>
                <div class="empty-title">Bạn chưa có lịch thi</div>
                <p class="empty-text">Lịch sẽ hiện ở đây khi giảng viên xếp ca thi cho bạn.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Kỳ thi</th>
                            <th>Trạng thái</th>
                            <th>Bắt đầu ca</th>
                            <th>Kết thúc ca</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="cell-title">@item.ExamName</td>
                                <td><partial name="_ExamStatus" model="item.Status" /></td>
                                <td>@item.StartAt.ToLocalText()</td>
                                <td>@item.EndAt.ToLocalText()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
