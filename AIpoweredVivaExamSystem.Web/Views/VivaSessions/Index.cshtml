@model IReadOnlyList<AIpoweredVivaExamSystem.Application.VivaSessions.MyVivaExam>
@{ ViewData["Title"] = "My viva session"; }
<div class="container stack">
    <h1>My viva session</h1>
    <p>@TempData["SessionMessage"]</p>
    <div asp-validation-summary="All"></div>
    @foreach (var exam in Model)
    {
        <div class="card">
            <h2>@exam.Name</h2><p>@exam.Status</p>
            <p>Slot: @(exam.ScheduledAt?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") ?? "Not scheduled") (Vietnam)</p>
            <form asp-action="Open" method="post">
                <input name="enrollmentId" type="hidden" value="@exam.EnrollmentId" />
                <button type="submit" class="btn btn-primary">Open / reopen session</button>
            </form>
        </div>
    }
    @if (Model.Count == 0) { <p>You are not enrolled in an exam.</p> }
</div>
