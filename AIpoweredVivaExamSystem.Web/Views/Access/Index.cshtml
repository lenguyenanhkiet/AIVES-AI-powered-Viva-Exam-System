@model AIpoweredVivaExamSystem.Application.Authentication.AccessOverview
@{ ViewData["Title"] = "Phân quyền"; }
<div class="container stack">
    <h1 class="page-title">Phân quyền và phân công môn học</h1>
    <p>Giảng viên quản lý câu hỏi và tài liệu do mình tạo trong các môn được phân công. Dữ liệu cũ chưa có người tạo được quản trị viên quản lý.</p>
    <div class="card"><table class="table"><thead><tr><th>Tài khoản</th><th>Vai trò</th></tr></thead><tbody>
    @foreach (var user in Model.Users)
    {
        <tr><td>@user.FullName — @user.Email</td><td>
        <form asp-action="Role" method="post"><input type="hidden" name="userId" value="@user.Id" />
            <select class="select" name="role" asp-items="@(new SelectList(Enum.GetValues<AIpoweredVivaExamSystem.Domain.Enums.UserRole>(), user.Role))"></select>
            <button class="btn btn-secondary" type="submit">Lưu</button>
        </form></td></tr>
    }
    </tbody></table></div>
    <h2>Phân công môn</h2>
    <form asp-action="Assign" method="post" class="card card-body stack">
        <label class="label">Giảng viên</label><select class="select" name="lecturerId" required>
        @foreach (var user in Model.Users.Where(u => u.Role == AIpoweredVivaExamSystem.Domain.Enums.UserRole.LECTURER))
        { <option value="@user.Id">@user.Email</option> }
        </select><label class="label">Môn học</label><select class="select" name="subjectId" required>
        @foreach (var subject in Model.Subjects) { <option value="@subject.Id">@subject.Code</option> }
        </select><button class="btn btn-primary" type="submit">Phân công</button>
    </form>
    <ul>@foreach (var assignment in Model.Assignments)
    { <li>@assignment.LecturerEmail — @assignment.SubjectCode
        <form asp-action="Unassign" method="post"><input type="hidden" name="id" value="@assignment.Id" /><button class="btn btn-secondary" type="submit">Gỡ phân công</button></form>
    </li> }</ul>
</div>
