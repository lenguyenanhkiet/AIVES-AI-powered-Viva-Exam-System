@model RubricFormViewModel
@{
    var isEdit = Model.Id is not null;
    var question = (QuestionResponse)ViewBag.Question;
    var total = Model.Criteria.Sum(x => x.MaxScore ?? 0);
}

<div class="card question-context">
    <div class="card-body">
        <div class="answer-label">Câu hỏi</div>
        <p class="question-text clamp-3">@question.Content</p>
        <div class="head-tags">
            <partial name="_Bloom" model="question.BloomLevel" />
            <partial name="_Difficulty" model="question.Difficulty" />
        </div>
    </div>
</div>

<form method="post" class="card" novalidate data-rubric-form>
    <input type="hidden" asp-for="QuestionId" />
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert"></div>
        <div class="form-grid">
            <div class="form-intro">
                <h2>Thông tin rubric</h2>
                <p>Mỗi câu hỏi có đúng một rubric. Tên ngắn gọn giúp giảng viên nhận ra rubric khi xem lại bài chấm.</p>
            </div>
            <div>
                <div class="field">
                    <label class="label" asp-for="Name">Tên rubric <span class="req">*</span></label>
                    <input class="input" asp-for="Name" placeholder="VD: Rubric DI lifetime" maxlength="255" autofocus />
                    <span class="field-error" asp-validation-for="Name"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Description"></label>
                    <textarea class="textarea" asp-for="Description" rows="2" placeholder="Hướng dẫn chung khi chấm…"></textarea>
                    <span class="hint">Không bắt buộc.</span>
                </div>
            </div>
        </div>

        <hr class="divider" />

        <div class="form-grid">
            <div class="form-intro">
                <h2>Tiêu chí chấm</h2>
                <p>Chia điểm theo từng ý cần có trong câu trả lời. Thứ tự tiêu chí là thứ tự AI chấm và hiển thị.</p>
            </div>
            <div>
                <div class="criteria-editor" data-criteria>
                    @for (var i = 0; i < Model.Criteria.Count; i++)
                    {
                        <div class="criterion" data-criterion>
                            <input type="hidden" asp-for="Criteria[i].Id" />
                            <div class="criterion-head">
                                <span class="criterion-index" data-criterion-index>@(i + 1)</span>
                                <input class="input" asp-for="Criteria[i].Name" placeholder="Tên tiêu chí, VD: Nêu đúng 3 loại lifetime" maxlength="255" />
                                <label class="score-input">
                                    <input class="input" asp-for="Criteria[i].MaxScore" type="number" step="0.25" min="0.25" max="999.99" placeholder="0" data-score />
                                    <span>điểm</span>
                                </label>
                                <button type="button" class="icon-btn danger" title="Xóa tiêu chí" data-remove-criterion>@Icons.Get("trash")</button>
                            </div>
                            <span class="field-error" asp-validation-for="Criteria[i].Name"></span>
                            <span class="field-error" asp-validation-for="Criteria[i].MaxScore"></span>
                            <div class="criterion-extra">
                                <input class="input" asp-for="Criteria[i].Description" placeholder="Cách chấm tiêu chí này (không bắt buộc)" />
                                <input class="input" asp-for="Criteria[i].ExpectedConcepts" placeholder="Khái niệm cần có, VD: Scoped, Transient, Singleton" />
                            </div>
                        </div>
                    }
                </div>
                <div class="criteria-foot">
                    <button type="button" class="btn btn-secondary btn-sm" data-add-criterion>@Icons.Get("plus", 14) Thêm tiêu chí</button>
                    <div class="rubric-total">Tổng điểm <strong><span data-total>@total.ToScore()</span> điểm</strong></div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a class="btn btn-secondary" asp-controller="Questions" asp-action="Details" asp-route-id="@Model.QuestionId">Hủy</a>
        <button type="submit" class="btn btn-primary">@Icons.Get("check") @(isEdit ? "Lưu rubric" : "Tạo rubric")</button>
    </div>
</form>

@* Blank row cloned by site.js; the __i__ index is renumbered before submit. *@
<template id="criterion-template">
    <div class="criterion" data-criterion>
        <div class="criterion-head">
            <span class="criterion-index" data-criterion-index></span>
            <input class="input" name="Criteria[__i__].Name" placeholder="Tên tiêu chí, VD: Nêu đúng 3 loại lifetime" maxlength="255" />
            <label class="score-input">
                <input class="input" name="Criteria[__i__].MaxScore" type="number" step="0.25" min="0.25" max="999.99" placeholder="0" data-score />
                <span>điểm</span>
            </label>
            <button type="button" class="icon-btn danger" title="Xóa tiêu chí" data-remove-criterion>@Icons.Get("trash")</button>
        </div>
        <div class="criterion-extra">
            <input class="input" name="Criteria[__i__].Description" placeholder="Cách chấm tiêu chí này (không bắt buộc)" />
            <input class="input" name="Criteria[__i__].ExpectedConcepts" placeholder="Khái niệm cần có, VD: Scoped, Transient, Singleton" />
        </div>
    </div>
</template>
