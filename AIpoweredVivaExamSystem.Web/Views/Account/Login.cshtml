@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="page-head"><div><h1>Đăng nhập AIVES</h1><p>Sử dụng tài khoản được cấp để truy cập hệ thống.</p></div></div>
<section class="card" style="max-width:480px;padding:24px">
    <form asp-controller="Account" asp-action="Login" method="post">
        @* FormTagHelper tự thêm token antiforgery; controller kiểm tra token trước khi xác thực. *@
        <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="input" type="email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Mật khẩu</label>
            @* Không đưa lại mật khẩu đã POST vào HTML khi đăng nhập thất bại. *@
            <input asp-for="Password" class="input" type="password" value="" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Đăng nhập</button></div>
    </form>
</section>
