@model ExamIndexViewModel
@{
    ViewData["Title"] = "Quản lý kỳ thi";
}

<div class="container">
    <div class="page-head">
        <div>
            <h1 class="page-title">Quản lý kỳ thi vấn đáp</h1>
            <p class="page-sub">Khởi tạo kỳ thi, quản lý vòng đời (Bản nháp → Công bố → Đang diễn ra → Hoàn thành) và cấu hình ca thi.</p>
        </div>
        <div class="head-actions">
            <a class="btn btn-primary" asp-action="Create">@Icons.Get("plus") Tạo kỳ thi mới</a>
        </div>
    </div>

    <div class="card">
        <nav class="tabs" aria-label="Lọc theo trạng thái">
            <a class="tab @(Model.FilterStatus is null ? "active" : "")" asp-action="Index">
                Tất cả <span class="tab-count">@Model.TotalCount</span>
            </a>
            @foreach (var (status, count) in Model.StatusCounts)
            {
                <a class="tab @(Model.FilterStatus == status ? "active" : "")" asp-action="Index" asp-route-status="@status">
                    @status.ToLabel() <span class="tab-count">@count</span>
                </a>
            }
        </nav>

        @if (Model.Exams.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon">@Icons.Get("calendar", 20)</div>
                <div class="empty-title">Chưa có kỳ thi nào</div>
                <p class="empty-text">Bạn chưa tạo kỳ thi nào hoặc không có kỳ thi nào ở trạng thái này.</p>
                <a class="btn btn-primary btn-sm" asp-action="Create">@Icons.Get("plus", 14) Tạo kỳ thi ngay</a>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Kỳ thi &amp; Môn học</th>
                            <th>Khung thời gian</th>
                            <th>Trạng thái</th>
                            <th class="actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.Exams)
                        {
                            Model.SubjectCodes.TryGetValue(exam.SubjectId, out var subCode);
                            Model.SubjectNames.TryGetValue(exam.SubjectId, out var subName);
                            <tr>
                                <td>
                                    <a class="cell-title" asp-action="Details" asp-route-id="@exam.Id">@exam.Name</a>
                                    <div class="cell-sub">
                                        <span class="code-chip">@(subCode ?? "Môn học")</span>
                                        <span>@(subName ?? "...")</span>
                                    </div>
                                </td>
                                <td>
                                    <div>@exam.StartAt.ToLocalText()</div>
                                    <div class="cell-sub muted">Đến @exam.EndAt.ToLocalText()</div>
                                </td>
                                <td>
                                    <partial name="_ExamStatusBadge" model="exam.Status" />
                                </td>
                                <td class="actions">
                                    <a class="icon-btn" title="Chi tiết" asp-action="Details" asp-route-id="@exam.Id">@Icons.Get("eye")</a>
                                    @if (exam.Status == ExamStatus.Draft)
                                    {
                                        <a class="icon-btn" title="Sửa" asp-action="Edit" asp-route-id="@exam.Id">@Icons.Get("edit")</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
