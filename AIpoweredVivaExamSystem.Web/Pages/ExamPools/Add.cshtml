@page "/ExamPools/Add/{id?}"
@model AIpoweredVivaExamSystem.Web.Pages.ExamPools.AddModel
@{
    ViewData["Title"] = "Pool câu hỏi";
    var poolPage = Model.Vm.Page;
    var selectedQuestionIds = Model.Input.QuestionIds.ToHashSet();
}

<div class="container stack">
    <div class="page-head">
        <div>
            <h1 class="page-title">Pool câu hỏi — @poolPage.Exam.Name</h1>
            <p class="page-sub">Chỉ câu đã duyệt, đúng môn, có rubric và thuộc ngân hàng của giảng viên phụ trách mới được dùng cho phiên thi mới.</p>
        </div>
        <div class="head-actions">
            <a class="btn btn-secondary" asp-route-id="@poolPage.Exam.Id" asp-page="/ExamFoundation/Details">Trạng thái kỳ thi</a>
        </div>
    </div>

    <div class="card stack">
        <div class="toolbar">
            <span><strong>Đang có trong pool:</strong> @poolPage.CurrentPoolCount</span>
            <span><strong>Đủ điều kiện:</strong> @poolPage.EligiblePoolCount</span>
            <span><strong>Số câu cần:</strong> @poolPage.RequiredQuestions</span>
            <span><partial name="_ExamStatus" model="poolPage.Exam.Status" /></span>
        </div>

        @if (!Model.Vm.CanEdit)
        {
            <div class="alert alert-info" role="status">Pool chỉ chỉnh sửa được khi kỳ thi còn ở trạng thái Nháp.</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert" role="alert"><div asp-validation-summary="All"></div></div>
        }

        <section class="stack">
            <div>
                <h2>Thêm câu hỏi đủ điều kiện</h2>
                <p class="muted">Chọn nhiều câu rồi thêm cùng lúc. Câu không còn đủ điều kiện sẽ khiến cả thao tác bị từ chối.</p>
            </div>
            @if (poolPage.AvailableQuestions.Count == 0)
            {
                <div class="empty">
                    <div class="empty-title">Không còn câu hỏi phù hợp để thêm</div>
                    <p class="empty-text">Câu trong pool hiện tại được liệt kê bên dưới, kể cả câu đã mất điều kiện.</p>
                </div>
            }
            else
            {
                <form asp-route-id="@poolPage.Exam.Id" method="post" class="stack" asp-page="/ExamPools/Add">
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th></th><th>Câu hỏi</th><th>Bloom</th><th>Độ khó</th><th>Rubric</th></tr></thead>
                            <tbody>
                            @foreach (var question in poolPage.AvailableQuestions)
                            {
                                <tr>
                                    <td><input type="checkbox" name="Input.QuestionIds" value="@question.Id" checked="@selectedQuestionIds.Contains(question.Id)" disabled="@(!Model.Vm.CanEdit)" aria-label="Chọn câu hỏi @question.Content để thêm vào pool" /></td>
                                    <td class="q-cell">@question.Content</td>
                                    <td><partial name="_Bloom" model="question.BloomLevel" /></td>
                                    <td><partial name="_Difficulty" model="question.Difficulty" /></td>
                                    <td><span class="rubric-yes">Có</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="head-actions">
                        <button class="btn btn-primary" type="submit" disabled="@(!Model.Vm.CanEdit)">Thêm câu đã chọn</button>
                    </div>
                </form>
            }
        </section>

        <section class="stack">
            <div>
                <h2>Câu hỏi đang có trong pool</h2>
                <p class="muted">Pool cần ít nhất @poolPage.RequiredQuestions câu còn đủ điều kiện trước khi có thể công bố kỳ thi.</p>
            </div>
            @if (poolPage.PooledQuestions.Count == 0)
            {
                <p class="muted">Pool hiện chưa có câu hỏi.</p>
            }
            else
            {
                <form asp-route-id="@poolPage.Exam.Id" method="post" class="stack" asp-page="/ExamPools/Remove">
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th></th><th>Câu hỏi</th><th>Trạng thái</th><th>Rubric</th><th>Điều kiện</th></tr></thead>
                            <tbody>
                            @foreach (var question in poolPage.PooledQuestions)
                            {
                                <tr>
                                    <td><input type="checkbox" name="Input.QuestionIds" value="@question.Id" disabled="@(!Model.Vm.CanEdit)" aria-label="Bỏ câu hỏi @question.Content khỏi pool" /></td>
                                    <td class="q-cell">@question.Content</td>
                                    <td><partial name="_QuestionStatus" model="question.Status" /></td>
                                    <td>@(question.HasRubric ? "Có" : "Không")</td>
                                    <td>
                                        @if (question.IsEligible)
                                        { <span class="rubric-yes">Đủ điều kiện</span> }
                                        else
                                        { <span class="muted">Không dùng cho phiên mới</span> }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="head-actions">
                        <button class="btn btn-secondary" type="submit" disabled="@(!Model.Vm.CanEdit)">Bỏ câu đã chọn</button>
                    </div>
                </form>
            }
        </section>
    </div>
</div>
