@model AIpoweredVivaExamSystem.Application.Contracts.ExamStatus
@{
    var css = Model switch
    {
        ExamStatus.Draft => "q-status-draft",
        ExamStatus.Published => "badge-active",
        ExamStatus.Ongoing => "q-status-approved",
        ExamStatus.Completed => "q-status-archived",
        ExamStatus.Cancelled => "q-status-rejected",
        _ => "badge-inactive"
    };
}
<span class="badge @css">@Model.ToLabel()</span>
