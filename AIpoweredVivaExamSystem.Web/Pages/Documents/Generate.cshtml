@page "/Documents/Generate/{id?}"
@model AIpoweredVivaExamSystem.Web.Pages.Documents.GenerateModel
@{ ViewData["Title"] = "Sinh câu hỏi AI"; }
<div class="container stack">
    <h1 class="page-title">Sinh câu hỏi từ @Model.Input.FileName</h1>
    <p>Các đoạn tài liệu phù hợp được gửi đến OpenAI để sinh câu hỏi Nháp. Mỗi câu có trích dẫn trang/slide để bạn kiểm tra trước khi thêm rubric và duyệt.</p>
    <div asp-validation-summary="All" class="alert"></div>
    <form method="post" class="card card-body stack" asp-page="/Documents/Generate">
        <input asp-for="Input.DocumentId" type="hidden" />
        <label class="label" asp-for="Input.TopicId">Chủ đề (tùy chọn)</label><select class="select" asp-for="Input.TopicId" asp-items="Model.Input.Topics"><option value="">Không chọn</option></select>
        <label class="label" asp-for="Input.Instruction">Nội dung cần kiểm tra</label><textarea class="textarea" asp-for="Input.Instruction" required maxlength="1000" rows="4"></textarea>
        <label class="label" asp-for="Input.BloomLevel">Bloom</label><select class="select" asp-for="Input.BloomLevel" asp-items="Html.GetEnumSelectList<BloomLevel>()"></select>
        <label class="label" asp-for="Input.Difficulty">Độ khó</label><select class="select" asp-for="Input.Difficulty" asp-items="Html.GetEnumSelectList<QuestionDifficulty>()"></select>
        <label class="label" asp-for="Input.Count">Số câu hỏi</label><input class="input" asp-for="Input.Count" type="number" min="1" max="10" />
        <button class="btn btn-primary" type="submit">Sinh câu hỏi Nháp</button>
    </form>
</div>
