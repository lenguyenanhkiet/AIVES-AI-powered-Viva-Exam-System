@page "/Rubrics/Create/{id?}"
@model AIpoweredVivaExamSystem.Web.Pages.Rubrics.CreateModel
@{
    ViewData["Title"] = "Tạo rubric";
}

<div class="container">
    <nav class="breadcrumb">
        <a asp-page="/Questions/Index">Câu hỏi</a> @Icons.Get("chevron-right", 14)
        <a asp-route-id="@Model.Input.QuestionId" asp-page="/Questions/Details">Chi tiết</a> @Icons.Get("chevron-right", 14)
        <span>Tạo rubric</span>
    </nav>
    <div class="page-head">
        <div>
            <h1 class="page-title">Tạo rubric</h1>
            <p class="page-sub">Định nghĩa các tiêu chí và điểm tối đa để AI chấm câu trả lời.</p>
        </div>
    </div>
    <partial name="_Form" model="Model.Input" />
</div>
