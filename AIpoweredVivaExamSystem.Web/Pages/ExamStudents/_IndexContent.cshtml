@model AIpoweredVivaExamSystem.Application.ExamStudents.RosterExamPage
@{ ViewData["Title"] = "Danh sách sinh viên kỳ thi"; }
<div class="container stack">
    <div class="page-head">
        <div>
            <h1 class="page-title">Sinh viên kỳ thi</h1>
            <p class="page-sub">Chọn kỳ thi để xem hoặc quản lý danh sách sinh viên. Thời gian hiển thị theo giờ Việt Nam (UTC+7).</p>
        </div>
    </div>
    <div class="card table-wrap">
        <table class="table">
            <thead><tr><th>Kỳ thi</th><th>Trạng thái</th><th>Bắt đầu</th><th>Kết thúc</th><th></th></tr></thead>
            <tbody>
            @foreach (var exam in Model.Items)
            {
                <tr>
                    <td>@exam.Name</td><td><partial name="_ExamStatus" model="exam.Status" /></td>
                    <td>@exam.StartAt.ToLocalText()</td><td>@exam.EndAt.ToLocalText()</td>
                    <td><a class="btn btn-secondary" asp-route-id="@exam.Id" asp-page="/ExamStudents/Roster">Danh sách sinh viên</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.TotalCount == 0)
        { <p>Chưa có kỳ thi thuộc quyền quản lý của bạn. Tạo kỳ thi trước khi thêm sinh viên.</p> }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pager" aria-label="Phân trang kỳ thi">
            <span>Trang @Model.Page / @Model.TotalPages · @Model.TotalCount kỳ thi</span>
            <div class="pager-nav">
                @if (Model.Page > 1)
                { <a class="btn btn-secondary" rel="prev" href="@Url.Page("/ExamStudents/Index")?page=@(Model.Page - 1)">Trước</a> }
                @if (Model.Page < Model.TotalPages)
                { <a class="btn btn-secondary" rel="next" href="@Url.Page("/ExamStudents/Index")?page=@(Model.Page + 1)">Sau</a> }
            </div>
        </nav>
    }
</div>
