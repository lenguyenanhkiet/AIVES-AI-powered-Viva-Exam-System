@page "/Exams/Edit/{id?}"
@model AIpoweredVivaExamSystem.Web.Pages.Exams.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa kỳ thi";
}

<div class="container">
    <nav class="breadcrumb">
        <a asp-page="/Exams/Index">Kỳ thi</a> @Icons.Get("chevron-right", 14)
        <a asp-route-id="@Model.Input.Id" asp-page="/Exams/Details">@Model.Input.Name</a> @Icons.Get("chevron-right", 14)
        <span>Chỉnh sửa</span>
    </nav>
    <div class="page-head">
        <h1 class="page-title">Chỉnh sửa kỳ thi (Bản nháp)</h1>
    </div>

    <form method="post" asp-route-id="@Model.Input.Id" asp-page="/Exams/Edit">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model.Input" />
    </form>
</div>
