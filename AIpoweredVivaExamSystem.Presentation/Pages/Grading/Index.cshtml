@page "/Grading/{examId:guid?}"
@model AIpoweredVivaExamSystem.Presentation.Pages.Grading.IndexModel
@{
    var vm = Model.Vm;
    ViewData["Title"] = vm is null ? "Chấm thi" : "Chấm thi — " + vm.ExamName;
}

<div class="container">
    @if (vm is null)
    {
        <div class="page-head">
            <div>
                <h1 class="page-title">Chấm thi vấn đáp</h1>
                <p class="page-sub">Chọn kỳ thi để xem bài làm của từng sinh viên, tham khảo gợi ý của AI và chốt điểm.</p>
            </div>
        </div>

        <div class="card">
            @if (Model.Exams.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon">@Icons.Get("checklist", 20)</div>
                    <div class="empty-title">Chưa có kỳ thi nào để chấm</div>
                    <p class="empty-text">Các kỳ thi thuộc môn bạn phụ trách sẽ hiện ở đây.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Kỳ thi</th><th>Khung thời gian</th><th>Trạng thái</th><th class="actions"><span class="sr-only">Thao tác</span></th></tr></thead>
                        <tbody>
                            @foreach (var exam in Model.Exams)
                            {
                                <tr>
                                    <td><a class="cell-title" asp-page="/Grading/Index" asp-route-examId="@exam.Id">@exam.Name</a></td>
                                    <td>
                                        <div>@exam.StartAt.ToLocalText()</div>
                                        <div class="cell-sub muted">Đến @exam.EndAt.ToLocalText()</div>
                                    </td>
                                    <td><partial name="_ExamStatus" model="exam.Status" /></td>
                                    <td class="actions"><a class="btn btn-secondary btn-sm" asp-page="/Grading/Index" asp-route-examId="@exam.Id">Xem bài thi @Icons.Get("chevron-right", 14)</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        var rows = vm.Sessions;
        int Count(string state) => rows.Count(r => r.State == state);
        var nextToGrade = rows.FirstOrDefault(r => r.SessionId is not null && r.State == "awaiting-review")
                          ?? rows.FirstOrDefault(r => r.SessionId is not null && r.State == "draft");

        <nav class="breadcrumb">
            <a asp-page="/Grading/Index">Chấm thi</a> @Icons.Get("chevron-right", 14) <span>@vm.ExamName</span>
        </nav>
        <div class="page-head">
            <div>
                <h1 class="page-title">@vm.ExamName</h1>
                <p class="grade-progress">
                    <span><strong>@Count("finalised")</strong> / @rows.Count đã chốt điểm</span>
                    <span><strong>@Count("awaiting-review")</strong> chờ chấm</span>
                    <span><strong>@Count("draft")</strong> đang chấm (nháp)</span>
                    <span><strong>@(Count("not-started") + Count("in-progress"))</strong> chưa thi xong</span>
                </p>
            </div>
            <div class="head-actions">
                <a class="btn btn-secondary" asp-page="/Exams/Details" asp-route-id="@vm.ExamId">Chi tiết kỳ thi</a>
                @if (nextToGrade is not null)
                {
                    <a class="btn btn-primary" asp-page="/Grading/Review" asp-route-id="@nextToGrade.SessionId">@Icons.Get("edit") Chấm bài tiếp theo: @nextToGrade.StudentName</a>
                }
            </div>
        </div>

        <div class="card">
            @if (rows.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon">@Icons.Get("users", 20)</div>
                    <div class="empty-title">Kỳ thi chưa có sinh viên</div>
                    <p class="empty-text">Thêm sinh viên vào danh sách dự thi để có bài cần chấm.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sinh viên</th>
                                <th>Trạng thái</th>
                                <th>Thời gian thi</th>
                                <th>Gợi ý AI</th>
                                <th>Điểm giảng viên</th>
                                <th class="actions"><span class="sr-only">Thao tác</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <td>
                                        <div class="cell-title">@row.StudentName</div>
                                        <div class="cell-sub muted">@row.StudentEmail</div>
                                    </td>
                                    <td><partial name="_GradeState" model="row.State" /></td>
                                    <td>
                                        @if (row.StartedAt is { } started)
                                        {
                                            <div>@started.ToLocalText()</div>
                                            <div class="cell-sub muted">@(row.CompletedAt is { } done ? "Kết thúc " + done.ToLocalText() : "Chưa kết thúc")</div>
                                        }
                                        else
                                        {
                                            <span class="score-none">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.SuggestedTotal is { } suggested)
                                        {
                                            <span class="ai-chip" title="Gợi ý của AI, chưa phải điểm">@Icons.Get("sparkles", 12) @suggested.ToScore() / @row.MaxTotal.ToScore()</span>
                                        }
                                        else
                                        {
                                            <span class="score-none">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.State == "finalised" && row.FinalTotal is { } total)
                                        {
                                            <span class="score-final">@total.ToScore()</span> <span class="muted">/ @row.MaxTotal.ToScore() · đã chốt</span>
                                        }
                                        else if (row.LecturerTotal is { } draft)
                                        {
                                            <span>@draft.ToScore()</span> <span class="muted">/ @row.MaxTotal.ToScore() · nháp</span>
                                        }
                                        else
                                        {
                                            <span class="score-none">Chưa chấm</span>
                                        }
                                    </td>
                                    <td class="actions">
                                        @if (row.SessionId is { } sid)
                                        {
                                            var (label, css) = row.State switch
                                            {
                                                "awaiting-review" => ("Chấm bài", "btn-primary"),
                                                "draft" => ("Tiếp tục chấm", "btn-secondary"),
                                                _ => ("Xem bài", "btn-secondary")
                                            };
                                            <a class="btn @css btn-sm" asp-page="/Grading/Review" asp-route-id="@sid" aria-label="@label — @row.StudentName">@label</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
